{
  "name": "redrope",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @redrope/web",
    "dev:api": "npm run dev -w @redrope/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @redrope/web",
    "build:api": "npm run build -w @redrope/api",
    "start": "npm run start -w @redrope/api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "npm run lint -w @redrope/web",
    "lint:api": "npm run lint -w @redrope/api",
    "preview": "npm run preview -w @redrope/web",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test -w @redrope/web",
    "test:api": "npm run test -w @redrope/api",
    "storybook": "npm run storybook -w @redrope/web",
    "build-storybook": "npm run build-storybook -w @redrope/web",
    "prepare": "husky install",
    "act": "act pull_request --secret-file .env.local -j Vercel-Preview"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.{js,css,md,json,yml,yaml}": "prettier --write"
  }
}
